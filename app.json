{
  "expo": {
    "name": "HealthOS Mobile",
    "slug": "healthos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#060608"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "HealthOS adds weekly progress reminders to your calendar.",
        "NSHealthShareUsageDescription": "HealthOS reads health data from your Galaxy Watch 4 via Health Connect.",
        "NSHealthUpdateUsageDescription": "HealthOS writes health metrics to improve tracking accuracy."
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060608"
      },
      "minSdkVersion": 26,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_WEIGHT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.manishraj.healthosmobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/f227ed4a-761b-4e43-b911-df8370b5391e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      "expo-updates",
      "expo-sqlite",
      "expo-calendar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F7BFF",
          "sounds": []
        }
      ],
      [
        "react-native-health-connect",
        {
          "package": "com.samsung.android.wear.shealth"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f227ed4a-761b-4e43-b911-df8370b5391e"
      }
    },
    "owner": "ken2407"
  }
}
